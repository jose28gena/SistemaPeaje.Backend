    public async Task<ActionResult<ProyeccionesTendenciasDto>> GetProyeccionesTendencias(
        [FromQuery] DateTime fechaDesde,
        [FromQuery] DateTime fechaHasta,
        [FromQuery] int diasProyeccion = 30,
        [FromQuery] int? estacionId = null)
    {
        var query = new GetProyeccionesTendenciasQuery
        {
            FechaDesde = fechaDesde,
            FechaHasta = fechaHasta,
            DiasProyeccion = diasProyeccion,
            EstacionId = estacionId
        };
        
        var proyecciones = await _mediator.Send(query);
        return Ok(proyecciones);
    }
}
