using MediatR;
using Microsoft.AspNetCore.Mvc;
using SistemaPeaje.Application.Features.TurnosAdmin.Reportes;
using SistemaPeaje.Application.DTOs.TurnosAdmin;

namespace SistemaPeaje.API.Controllers;

[ApiController]
[Route("api/turnos-admin/[controller]")]
public class ReportesTurnosController : ControllerBase
{
    private readonly IMediator _mediator;

    public ReportesTurnosController(IMediator mediator)
    {
        _mediator = mediator;
    }

    /// <summary>
    /// Obtiene reporte de productividad por empleado
    /// </summary>
    [HttpGet("productividad-empleados")]
    public async Task<ActionResult<ReporteProductividadEmpleadosDto>> GetReporteProductividadEmpleados(
        [FromQuery] DateTime fechaDesde,
        [FromQuery] DateTime fechaHasta,
        [FromQuery] int? empleadoId = null,
        [FromQuery] int? estacionId = null)
    {
        var query = new GetReporteProductividadEmpleadosQuery
        {
            FechaDesde = fechaDesde,
            FechaHasta = fechaHasta,
            EmpleadoId = empleadoId,
            EstacionId = estacionId
        };
        
        var reporte = await _mediator.Send(query);
        return Ok(reporte);
    }

    /// <summary>
    /// Obtiene reporte de rendimiento por turnos
    /// </summary>
    [HttpGet("rendimiento-turnos")]
    public async Task<ActionResult<ReporteRendimientoTurnosDto>> GetReporteRendimientoTurnos(
        [FromQuery] DateTime fechaDesde,
        [FromQuery] DateTime fechaHasta,
        [FromQuery] int? estacionId = null,
        [FromQuery] string? tipoTurno = null)
    {
        var query = new GetReporteRendimientoTurnosQuery
        {
            FechaDesde = fechaDesde,
            FechaHasta = fechaHasta,
            EstacionId = estacionId,
            TipoTurno = tipoTurno
        };
        
        var reporte = await _mediator.Send(query);
        return Ok(reporte);
    }

    /// <summary>
    /// Obtiene reporte de asistencia y puntualidad
